package main

import (
	"encoding/json"
	"fmt"
	"log"
	"net/http"
	"os"
	"sort"
	"strconv"
	"time"

	"github.com/go-echarts/go-echarts/v2/charts"
	"github.com/go-echarts/go-echarts/v2/opts"
	"github.com/go-echarts/go-echarts/v2/types"

	"github.com/mwlazlo/srs"
)

var (
	bars srs.Series
)

type winloss struct {
	win  int
	loss int
}

func (w *winloss) addWin() {
	w.win++
}

func (w *winloss) addLoss() {
	w.loss++
}

func (w *winloss) winRate() int {
	return w.win * 100 / (w.win + w.loss)
}

func init() {
	var err error
	bars, err = srs.ReadBarsFromCSV("data/dax-5m-fixed.csv", false)
	if err != nil {
		panic(err)
	}
}

